{
  "name": "portfolio/rentflow",
  "description": "DDD/CQRS portfolio project in PHP",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-pdo": "*",
    "ext-rdkafka": "*",
    "doctrine/dbal": "^4.4",
    "doctrine/doctrine-bundle": "^3.1",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/flex": "^2.7",
    "symfony/framework-bundle": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "test": "phpunit",
    "post-install-cmd": ["@auto-scripts"],
    "post-update-cmd": ["@auto-scripts"]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
